{
  "model_name": "DCACNet",
  "description": "Lightweight deep learning model for skin lesion classification",
  "num_classes": 7,
  "image_size": 224,
  "class_names": [
    "akiec",
    "bcc",
    "bkl",
    "df",
    "mel",
    "nv",
    "vasc"
  ],
  "class_descriptions": {
    "akiec": "Actinic Keratoses and Intraepithelial Carcinoma",
    "bcc": "Basal Cell Carcinoma",
    "bkl": "Benign Keratosis",
    "df": "Dermatofibroma",
    "mel": "Melanoma",
    "nv": "Melanocytic Nevi",
    "vasc": "Vascular Lesions"
  },
  "preprocessing": {
    "resize": [
      224,
      224
    ],
    "normalize": {
      "mean": [
        0.5,
        0.5,
        0.5
      ],
      "std": [
        0.5,
        0.5,
        0.5
      ]
    }
  },
  "input_format": "RGB",
  "input_shape": [
    1,
    3,
    224,
    224
  ],
  "output_shape": [
    1,
    7
  ]
}